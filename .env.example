# =========================================================================
# LifeStack Finance — Environment Variables
# Copy to .env.local for local development; set in Vercel for production.
# =========================================================================

# ── Supabase (required) ───────────────────────────────────────────────────
# Project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://ynvfzssakggmmldjkmes.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── FRED API (required for live market data) ──────────────────────────────
# Free key from: https://fred.stlouisfed.org/docs/api/api_key.html
# Enables live: VIX, US yields, credit spreads (IG/HY OAS), CPI, fed funds, M2, SP500, DXY
# Without this key the module falls back to hardcoded March 2026 baseline data.
FRED_API_KEY=your_fred_api_key_here

# ── OpenTelemetry APM (optional) ─────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.kubiks.app
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=x-kubiks-key=your_kubiks_api_key_here
OTEL_SERVICE_NAME=lifestack-finance
